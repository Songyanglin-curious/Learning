<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a" value="时刻 A：磁场增强" style="text;fontSize=22;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="600" height="40" as="geometry"/></mxCell><mxCell id="b" value="交流电源" style="rounded=1;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="150" height="80" as="geometry"/></mxCell><mxCell id="c" value="线圈：磁场储能增加" style="rounded=1;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="220" height="80" as="geometry"/></mxCell><mxCell id="d" value="能量进入" style="endArrow=block;strokeWidth=4;fontSize=18;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e" value="时刻 B：磁场减弱" style="text;fontSize=22;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="600" height="40" as="geometry"/></mxCell><mxCell id="f" value="交流电源" style="rounded=1;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="150" height="80" as="geometry"/></mxCell><mxCell id="g" value="线圈：磁场储能减少" style="rounded=1;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="220" height="80" as="geometry"/></mxCell><mxCell id="h" value="能量退回" style="endArrow=block;strokeWidth=4;fontSize=18;" edge="1" parent="1" source="g" target="f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="i" value="假设：只有理想交流电源与理想线圈，忽略电阻。箭头表示能量方向，不是电子运动方向。" style="text;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="620" height="60" as="geometry"/></mxCell></root></mxGraphModel>